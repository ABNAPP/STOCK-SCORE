{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_BASE_URL": "https://value-insight-be-f8a5039709ae.herokuapp.com"
  },
  "rewrites": [
    { "source": "/eodhd-proxy/:path*", "destination": "https://eodhd.com/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/((?!assets/|vite.svg|favicon).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }] }
  ]
}
